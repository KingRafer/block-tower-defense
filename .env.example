# Salin ke Environment Variables di Vercel (Project → Settings → Environment Variables)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/block_tower_defense?retryWrites=true&w=majority
MONGODB_DB=block_tower_defense
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Hanya untuk uji lokal (jangan diaktifkan di production):
# DEV_AUTH=1
# Email akun Google yang boleh membuka Panel Developer (pisahkan dengan koma)
# ADMIN_EMAILS=rafermazaya@gmail.com
